# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# static export output is rebuilt locally before S3 upload

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local

# catalog importer working files / generated catalog (keep fixtures if committed intentionally)
tools/catalog-importer/.work/
tools/catalog-importer/node_modules/
public-catalog/products/
public-catalog/import-report.json
public-catalog/review-queue.json
public/products/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test
playwright-report
test-results
