# Frontend / CDN (baked at build time for the static export)
# Leave empty to load /catalog.json from the same CloudFront/S3 origin as the app.
# Example: https://cdn.animarte.website
NEXT_PUBLIC_CATALOG_CDN_URL=

# Google Drive (catalog importer only — not used by the storefront runtime)
GOOGLE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_ANIME_FOLDER_ID=
GOOGLE_CARTOON_FOLDER_ID=
GOOGLE_SUPERHEROS_FOLDER_ID=
GOOGLE_DISNEY_FOLDER_ID=
GOOGLE_SERIES_FOLDER_ID=
GOOGLE_MUSIC_FOLDER_ID=
GOOGLE_FOOTBALL_FOLDER_ID=
GOOGLE_COVER_ID=
GOOGLE_GAMES_FOLDER_ID=

# AI provider (catalog importer only)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Playwright (optional)
PLAYWRIGHT_BASE_URL=http://localhost:3001
